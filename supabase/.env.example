# Copy to supabase/.env, fill in, then run:  supabase secrets set --env-file supabase/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically - do not add them.)

# From: node scripts/generate-rsa-keys.mjs  (paste the three lines it prints)
RSA_N=paste-the-RSA_N-hex-here
RSA_E=paste-the-RSA_E-hex-here
RSA_D=paste-the-RSA_D-hex-here

# Ethereum Sepolia testnet (for Polygon Amoy use chain id 80002 and MIN_PRIORITY_GWEI=30)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
MIN_PRIORITY_GWEI=2
CONTRACT_ADDRESS=0xYourDeployedSAVotingAddress
RELAYER_PRIVATE_KEY=0xPrivateKeyOfTheRelayerWalletFundedWithTestETH

# Optional: set to true to test the "face not recognised" error screen
MOCK_BIOMETRIC_FAIL=false
