# Local use: copy to .streamlit/secrets.toml
# Streamlit Community Cloud: paste these lines into App settings -> Secrets
RPC_URL = "https://ethereum-sepolia-rpc.publicnode.com"
CONTRACT_ADDRESS = "0xYourDeployedSAVotingAddress"
# Block number where you deployed the contract (shown on Etherscan). Scanning starts here.
DEPLOY_BLOCK = "0"
EXPLORER_URL = "https://sepolia.etherscan.io"
